# Copy this file to .env.local and fill in your own values (.env* files are git-ignored).
# Without these the game still runs fully offline.

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
# The publishable key is designed to be public in the browser, but only because
# Row Level Security is switched on for every table (see supabase/migrations).
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service_role / secret key in any VITE_ variable or in this repo.
