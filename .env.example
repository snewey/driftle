# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# Not needed yet: the game runs fully offline until Supabase is connected.

# From Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
# The "publishable" (anon) key is designed to be public in the browser,
# but ONLY because Row Level Security is enabled on every table.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service_role / secret key in any VITE_ variable or in this repo.
